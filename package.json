{
  "name": "@idikaeliada/my-first-npm",
  "version": "1.0.0",
  "description": "My first npm package – simple utilities to get started with publishing",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest --run",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdikaEliada/my-first-npm.git"
  },
  "keywords": [
    "first-package",
    "learning",
    "npm",
    "typescript"
  ],
  "author": "Idika Eliada <your-email@example.com>[](https://github.com/IdikaEliada)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IdikaEliada/my-first-npm/issues"
  },
  "homepage": "https://github.com/IdikaEliada/my-first-npm#readme",
  "devDependencies": {
    "@types/node": "^25.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}